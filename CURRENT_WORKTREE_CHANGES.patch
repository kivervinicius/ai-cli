+func TestHeadlessKickoffArgsMatchProviderCLIContracts(t *testing.T) {
+	ctx := context.Background()
+	profile := model.Profile{Name: "default"}
+	cases := []struct {
+		name string
+		d    ControlDriver
+		want []string
+	}{
+		{name: "claude", d: NewClaudeDriver(), want: []string{"-p", "ship it"}},
