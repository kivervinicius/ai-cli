# Copy to .env and set I_ACCEPT_HOST_PARITY=1 after reading docs/getting-started/docker-compat.md

HOST_HOME_DIR=${HOME}
HOST_UID=1000
HOST_GID=1000
WORKSPACE_DIR=/projetos
HOST_BIND_ADDRESS=127.0.0.1
NEXUS_WEB_PORT=7420
I_ACCEPT_HOST_PARITY=0
ENABLE_SSH_AGENT=0
# When ENABLE_SSH_AGENT=1, set SSH_AUTH_SOCK_MOUNT to the real agent socket path.
SSH_AUTH_SOCK_MOUNT=/dev/null
RUN_USER_DIR=/dev/null
WITH_PROVIDER_CLIS=1
