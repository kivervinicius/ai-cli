{
  "name": "ai-control-web",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "build:css": "tailwindcss -i src/index.css -o dist/bundle.css --minify",
    "build:js": "bun build src/index.tsx --outdir dist --entry-naming bundle.[ext] --minify",
    "build": "bun run build:css && bun run build:js && cp index.html dist/index.html && cp ../logo.png dist/logo.png && cp -r dist/* ../internal/control/web/dist/"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.0.0"
  }
}
